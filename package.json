{
  "name": "freetokenbox",
  "version": "1.0.0",
  "private": true,
  "description": "FreeTokenBox — 免费送 Token 网站收录。收集所有免费赠送 AI token / API 额度的网站与活动，提供 SEO 友好的列表、详情页、开放 API 与后台录入。",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply freetokenbox --local",
    "db:migrate:remote": "wrangler d1 migrations apply freetokenbox --remote",
    "db:seed": "node scripts/seed.js",
    "test": "node scripts/test-local.js"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "wrangler": "^4.105.0"
  }
}
